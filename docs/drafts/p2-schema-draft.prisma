// Review draft only. Do not copy into schema.prisma until P1/P3 confirm the open questions.
// P1-owned Tenant and User models are referenced by name; their inverse fields are not added here.
// The migration must create customer_subscription_number_seq before applying the Subscription default below.

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DiscountKind {
  FIXED
  PERCENT
}

enum DiscountAppliesTo {
  PRODUCTS
  SUBSCRIPTIONS
}

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  name      String?
  userId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?          @relation("CustomerPortalUser", fields: [userId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([tenantId, userId])
}

model Product {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  type       String
  salesPrice Decimal  @db.Decimal(12, 2)
  costPrice  Decimal  @db.Decimal(12, 2)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants          ProductVariant[]
  templateLines     QuotationTemplateLine[]
  subscriptionLines SubscriptionLine[]
  discountTargets   DiscountProduct[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, type])
}

model ProductVariant {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  attribute  String
  value      String
  extraPrice Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model Plan {
  id              String        @id @default(cuid())
  tenantId        String
  name            String
  price           Decimal       @db.Decimal(12, 2)
  billingPeriod   BillingPeriod
  minimumQuantity Int           @default(1)
  availableFrom   DateTime?
  availableUntil  DateTime?
  autoClose       Boolean       @default(false)
  closable        Boolean       @default(true)
  pausable        Boolean       @default(false)
  renewable       Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotationTemplates  QuotationTemplate[]
  subscriptions       Subscription[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, name])
  @@index([tenantId, availableFrom, availableUntil])
}

model QuotationTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  validityDays Int
  planId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan          Plan                    @relation(fields: [tenantId, planId], references: [tenantId, id])
  lines         QuotationTemplateLine[]
  subscriptions Subscription[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, planId])
}

model QuotationTemplateLine {
  id        String   @id @default(cuid())
  tenantId  String
  templateId String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  taxRate   Decimal  @db.Decimal(7, 4)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template QuotationTemplate @relation(fields: [tenantId, templateId], references: [tenantId, id], onDelete: Cascade)
  product  Product           @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, templateId])
  @@index([tenantId, productId])
}

model Subscription {
  id                String             @id @default(cuid())
  tenantId          String
  number            BigInt             @unique @default(dbgenerated("nextval('customer_subscription_number_seq'::regclass)"))
  idempotencyKey    String?
  customerId        String
  planId            String
  sourceTemplateId  String?
  status            SubscriptionStatus @default(DRAFT)
  startDate         DateTime?
  expiryDate        DateTime?
  quotationExpiresAt DateTime?
  nextInvoiceDate   DateTime?
  quantity          Int                @default(1)
  paymentTerms      String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer       Customer           @relation(fields: [tenantId, customerId], references: [tenantId, id])
  plan           Plan               @relation(fields: [tenantId, planId], references: [tenantId, id])
  sourceTemplate QuotationTemplate? @relation(fields: [tenantId, sourceTemplateId], references: [tenantId, id])
  lines          SubscriptionLine[]
  auditEvents    AuditEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId])
  @@index([tenantId, customerId, status])
  @@index([tenantId, planId, status])
  @@index([tenantId, sourceTemplateId])
  @@index([tenantId, nextInvoiceDate])
  @@index([tenantId, expiryDate, status])
}

model SubscriptionLine {
  id             String   @id @default(cuid())
  tenantId       String
  subscriptionId String
  productId      String
  taxId          String?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(12, 2)
  taxRate        Decimal  @db.Decimal(7, 4)
  taxAmount      Decimal  @db.Decimal(12, 2)
  amount         Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)
  product      Product      @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, subscriptionId])
  @@index([tenantId, productId])
  @@index([tenantId, taxId])
}

model DiscountRule {
  id              String            @id @default(cuid())
  tenantId        String
  name            String
  kind            DiscountKind
  value           Decimal           @db.Decimal(12, 2)
  minimumPurchase Decimal?           @db.Decimal(12, 2)
  minimumQuantity Int?
  startsAt        DateTime
  endsAt          DateTime?
  usageLimit      Int?
  usageCount      Int               @default(0)
  appliesTo       DiscountAppliesTo
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  targets  DiscountProduct[]
  usages   DiscountUsage[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, startsAt, endsAt, appliesTo])
  @@index([tenantId, minimumQuantity])
  @@index([tenantId, usageLimit, usageCount])
}

model DiscountProduct {
  id         String   @id @default(cuid())
  tenantId   String
  discountId String
  productId  String
  createdAt  DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discount DiscountRule @relation(fields: [tenantId, discountId], references: [tenantId, id], onDelete: Cascade)
  product  Product      @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, discountId, productId])
  @@index([tenantId])
  @@index([tenantId, productId])
}

model DiscountUsage {
  id         String   @id @default(cuid())
  tenantId   String
  discountId String
  invoiceId  String
  recordedAt DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discount DiscountRule @relation(fields: [tenantId, discountId], references: [tenantId, id])

  @@unique([tenantId, discountId, invoiceId])
  @@index([tenantId])
  @@index([tenantId, invoiceId])
}

model AuditEvent {
  id             String             @id @default(cuid())
  tenantId       String
  subscriptionId String
  idempotencyKey String?
  actorId        String?
  eventType      String
  fromStatus     SubscriptionStatus?
  toStatus       SubscriptionStatus?
  details        Json?
  createdAt      DateTime           @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor        User?        @relation("SubscriptionAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subscription Subscription @relation(fields: [tenantId, subscriptionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, actorId])
  @@unique([tenantId, id])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, subscriptionId, createdAt])
  @@index([tenantId, eventType, createdAt])
}
